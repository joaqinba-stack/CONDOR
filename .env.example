# Copiar a .env.local (en tu computadora) o cargar en Vercel → Settings → Environment Variables.
# Sin SUPABASE_* el sitio corre en MODO DEMO (catálogo de ejemplo, sin cobros reales).

# ── Sitio ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_NAME=Condor
NEXT_PUBLIC_SITE_URL=https://tudominio.com
CONTACT_EMAIL=hola@tudominio.com
# Emails que pueden entrar a /admin (separados por coma)
ADMIN_EMAILS=vos@tudominio.com
# Texto largo y aleatorio. Generar con: openssl rand -base64 32
SESSION_SECRET=

# ── Base de datos (Supabase → Project Settings → API) ────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Mercado Pago (Tus integraciones → tu aplicación) ─────────────────
MP_ACCESS_TOKEN=
# Webhooks → "Clave secreta"
MP_WEBHOOK_SECRET=

# ── PayPal (developer.paypal.com → Apps & Credentials) ───────────────
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# "sandbox" para pruebas, "live" para cobrar de verdad
PAYPAL_ENV=sandbox

# ── Bunny Stream: biblioteca PROTEGIDA (videos completos) ────────────
BUNNY_LIBRARY_ID=
BUNNY_API_KEY=
BUNNY_READONLY_API_KEY=
# Security → Token authentication key
BUNNY_TOKEN_AUTH_KEY=

# ── Bunny Stream: biblioteca PÚBLICA (tráilers) ──────────────────────
BUNNY_TRAILER_LIBRARY_ID=
BUNNY_TRAILER_API_KEY=
BUNNY_TRAILER_READONLY_API_KEY=
# Ej: vz-abc123-456.b-cdn.net (sin https://)
BUNNY_TRAILER_CDN_HOST=

# ── Emails (resend.com) ──────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=Condor <hola@tudominio.com>
